# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime environment variables
# Automatically injected by AI Studio Cloud SQL integration:
SQL_HOST="127.0.0.1"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="ai_studio_user"
SQL_PASSWORD="password"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="password"
